# ────────────────────────────────────────────────────────────────────
#  بعثت مردم — محیط توسعه‌ی محلی
#  این فایل را به `.env.local` کپی کن. هرگز مقدار واقعی را کامیت نکن.
# ────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# فقط سمت سرور
REVALIDATE_SECRET=
INDEXNOW_SECRET=

# منبع اسکیما برای `npm run api:types`
# پیش‌فرض https://besat.me/api/schema/ است؛ برای بک‌اند محلی:
# SCHEMA_SRC=http://127.0.0.1:8000/api/schema/
