# Besat frontend — production template
# Both the website and API are reverse-proxied on the same HTTPS origin.
# NEXT_PUBLIC_* values are embedded at build time; rebuild after changing them.

NEXT_PUBLIC_SITE_URL=https://besat.me
NEXT_PUBLIC_API_URL=https://besat.me

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Server-only webhook secrets (set in the deployment environment, never commit values)
REVALIDATE_SECRET=
INDEXNOW_SECRET=
