# ────────────────────────────────────────────────────────────────────
#  بعثت مردم — محیط PRODUCTION
# ────────────────────────────────────────────────────────────────────
#  این فایل را روی سرور به `.env.production` کپی کن.
#
#  روی پروداکشن، فرانت و API روی یک origin واحد سرو می‌شوند
#  (nginx مسیرهای /api/ و /admin/ و /media/ را به جنگو می‌فرستد و
#   بقیه را به Next). پس هر دو مقدار زیر یکسان‌اند.
#
#  ⚠️ مقادیر NEXT_PUBLIC_* در زمان بیلد داخل باندل کلاینت جاسازی
#     می‌شوند — بعد از تغییرشان حتماً دوباره بیلد بگیر.
#     (اسکریپت ./update-front.sh این کار را خودکار انجام می‌دهد.)
# ────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://besat.me
NEXT_PUBLIC_API_URL=https://besat.me

# تحلیل و اندازه‌گیری (اختیاری)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── فقط سمت سرور ─────────────────────────────────────────────────
#  این‌ها هرگز به کلاینت نمی‌روند. مقدارشان را در فایل واقعی بگذار،
#  نه در همین نمونه.
REVALIDATE_SECRET=
INDEXNOW_SECRET=
